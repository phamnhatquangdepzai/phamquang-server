SEV_ADMIN_USER=admin
# Change this to a unique password (at least 16 characters) before deployment.
SEV_ADMIN_PASSWORD=CHANGE-THIS-TO-A-LONG-RANDOM-PASSWORD
# Random secret of at least 32 characters. Never put this in the iOS app or Git.
SEV_SECRET_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARS
SEV_DB_PATH=./sev.sqlite3
